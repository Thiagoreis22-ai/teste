# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=SUBSTITUIR_POR_CHAVE_UNICA_DE_48_BYTES_OU_MAIS
# SQLite somente ambiente local. Em producao configure PostgreSQL.
DATABASE_URL=sqlite:///./mobilitypro.db
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# URL base de servidor OSRM dedicado ou provedor equivalente (HTTPS)
ROUTING_URL=
# Sem servidor de rotas, a plataforma rejeita corridas externas ao ambiente de teste.
ALLOW_DEV_DIRECT_DISTANCE=false
# API externa de mapas, SMS, Push e pagamentos requer integracoes futuras.
PAYMENT_PROVIDER=
SMS_PROVIDER=
MAPS_PROVIDER=
